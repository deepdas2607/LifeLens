{
    "manifest_version": 3,
    "name": "LifeLens: Memory Assistant",
    "version": "1.0",
    "description": "Capture memories and recall them instantly with LifeLens.",
    "permissions": [
        "storage",
        "activeTab",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "http://localhost:8501/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "popup.html"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}