{
    "manifest_version": 3,
    "name": "LifeLens: Memory Assistant",
    "version": "1.0",
    "description": "Capture memories and recall them instantly with LifeLens.",
    "permissions": [
        "storage",
        "activeTab",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "http://localhost:8501/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    }
}