# LifeLens Environment Configuration
# Get keys from:
# GROQ: https://console.groq.com/keys
# GEMINI: https://makersuite.google.com/app/apikey

GROQ_API_KEY=
GEMINI_API_KEY=

# Qdrant Cloud URL and API key
QDRANT_URL=
QDRANT_API_KEY=

# JWT secret used for auth tokens
JWT_SECRET=lifelens_super_secret_key_2025

# Notification topic (optional)
NTFY_TOPIC_URL=https://ntfy.sh/lifelens-caregiver-alerts
